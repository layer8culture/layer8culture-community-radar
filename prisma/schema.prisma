// Community Radar — Prisma schema (Supabase-compatible Postgres)
// Run `npx prisma generate` after editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  twitter
  instagram
  youtube
  tiktok
  reddit
}

enum EngagementTrend {
  rising
  stable
  declining
}

enum SuggestedAction {
  like
  comment
  repost
  follow
  dm
  invite
}

enum ContentStatus {
  idea
  drafting
  scheduled
  posted
}

enum TrendType {
  sound
  format
  hashtag
  topic
}

enum TrendMomentum {
  rising
  peaking
  fading
}

model Influencer {
  id                String          @id @default(cuid())
  handle            String
  platform          Platform
  niche             String
  followerCount     Int             @default(0)
  postingFrequency  Int             @default(0)
  engagementTrend   EngagementTrend @default(stable)
  relevanceScore    Int             @default(50)
  socialLinks       Json            @default("[]")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  relationships     Relationship[]

  @@unique([handle, platform])
}

model Hashtag {
  id             String    @id @default(cuid())
  name           String
  platform       Platform
  relevanceScore Int       @default(50)
  lastCheckedAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@unique([name, platform])
}

model Post {
  id                  String          @id @default(cuid())
  content             String
  creatorHandle       String
  platform            Platform
  engagementVelocity  Int             @default(0)
  relevanceScore      Int             @default(50)
  opportunityScore    Int             @default(0)
  suggestedAction     SuggestedAction @default(comment)
  url                 String?
  sourceHashtag       String?
  createdAt           DateTime        @default(now())
}

model Relationship {
  id                String       @id @default(cuid())
  creatorHandle     String
  platform          Platform
  liked             Boolean      @default(false)
  commented         Boolean      @default(false)
  followed          Boolean      @default(false)
  replied           Boolean      @default(false)
  invited           Boolean      @default(false)
  collaboratorScore Int          @default(0)
  notes             String       @default("")
  influencerId      String?
  influencer        Influencer?  @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([creatorHandle, platform])
}

// --- Organic-growth models (Instagram + TikTok) ---
// Content/Trends/MyAccount reuse the shared Platform enum but are validated to
// instagram | tiktok at the application layer.

model ContentIdea {
  id           String        @id @default(cuid())
  topic        String
  platform     Platform
  format       String        @default("reel")
  hook         String        @default("")
  hooks        String[]      @default([])
  scriptBeats  String[]      @default([])
  caption      String        @default("")
  firstComment String        @default("")
  hashtags     String[]      @default([])
  audioIdea    String        @default("")
  cta          String        @default("")
  status       ContentStatus @default(idea)
  scheduledFor DateTime?
  notes        String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Trend {
  id          String        @id @default(cuid())
  platform    Platform
  type        TrendType
  title       String
  description String        @default("")
  momentum    TrendMomentum @default(rising)
  exampleUrl  String?
  createdAt   DateTime      @default(now())
}

model MyAccount {
  id          String             @id @default(cuid())
  platform    Platform
  handle      String
  displayName String             @default("")
  followers   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  snapshots   FollowerSnapshot[]
  posts       MyPost[]

  @@unique([handle, platform])
}

model FollowerSnapshot {
  id           String    @id @default(cuid())
  accountId    String
  account      MyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date         DateTime
  followers    Int       @default(0)
  reach        Int       @default(0)
  profileViews Int       @default(0)
  createdAt    DateTime  @default(now())
}

model MyPost {
  id        String    @id @default(cuid())
  accountId String
  account   MyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform  Platform
  title     String
  format    String    @default("reel")
  postedAt  DateTime
  reach     Int       @default(0)
  likes     Int       @default(0)
  comments  Int       @default(0)
  shares    Int       @default(0)
  saves     Int       @default(0)
  follows   Int       @default(0)
  createdAt DateTime  @default(now())
}
