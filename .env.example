# Supabase Postgres connection string (leave blank to run with in-memory mock store)
DATABASE_URL=""

# --- AI provider for /api/generate-comment ---
# Priority order: GITHUB_TOKEN → OPENAI_API_KEY → deterministic fallback templates.

# Option A: GitHub Models (recommended — works with your GitHub account; free tier).
# Create a fine-grained PAT with the `models:read` scope at:
#   https://github.com/settings/personal-access-tokens
# Note: this is NOT your Copilot subscription token. GitHub Models is a separate,
# free, OpenAI-compatible inference API; a Copilot subscription is not required.
GITHUB_TOKEN=""
GITHUB_MODELS_MODEL="openai/gpt-4o-mini"

# Option B: OpenAI (used only if GITHUB_TOKEN is not set).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Real-data ingestion (POST /api/refresh) ---

# YouTube Data API v3 key. Get one free at:
#   https://console.cloud.google.com → "Enable APIs & Services" → "YouTube Data API v3"
# Then Credentials → Create credentials → API key.
YOUTUBE_API_KEY=""

# Reddit reads. Two modes — both work from any IP:
#
# (a) RSS fallback (default): no credentials required. Just set a unique
#     User-Agent. Works on Vercel out of the box. Trade-off: no upvote or
#     comment counts, so engagement velocity uses a flat default and the
#     opportunity score leans more on freshness + relevance.
#
# (b) OAuth (full data): set REDDIT_CLIENT_ID + REDDIT_CLIENT_SECRET below.
#     Use this once your Reddit API application at
#     https://www.reddit.com/prefs/apps is approved.
REDDIT_USER_AGENT="community-radar/0.1 (by /u/your_reddit_username)"
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Optional: protect /api/refresh behind a shared secret.
# When set, the route requires `Authorization: Bearer <secret>`.
# Leave blank for local dev.
CRON_SECRET=""

# --- TikTok (Playwright/Chromium scraper) ---
# Opt-in. Set to "true" only on a runtime that can host headless Chromium
# (Azure App Service, a long-lived container, or a local dev box). Will NOT
# work in Vercel serverless functions due to bundle-size and cold-start limits.
#
# After enabling, install the browser once on the host:
#   npm run setup:tiktok
#   # equivalent to: npx playwright install --with-deps chromium
#
# Trade-offs (same call you make with the Reddit RSS fallback):
#   - Scraping is against TikTok's ToS. Use at your own discretion.
#   - The internal item_list XHR shape rotates every few months. When it does,
#     only src/lib/ingestTikTok.ts needs to change.
TIKTOK_SCRAPER_ENABLED=""
TIKTOK_SCRAPER_USER_AGENT=""        # default: realistic desktop Chrome UA
TIKTOK_SCRAPER_TIMEOUT_MS="30000"   # per-hashtag XHR wait timeout (ms)
TIKTOK_SCRAPER_MAX_POSTS="15"
TIKTOK_PROXY_URL=""                 # optional, e.g. http://user:pass@host:port

# --- Instagram (official Graph API hashtag search) ---
# Opt-in and the ONLY ToS-compliant way to read other creators' IG posts.
# Requirements:
#   - An Instagram Business/Creator account linked to a Facebook Page.
#   - A long-lived access token with instagram_basic + pages_read_engagement.
#   - Your IG user id (the numeric id of the linked IG account).
# Limits: at most 30 unique hashtags per account per rolling 7 days, and
# hashtag media does NOT expose the owner's username (we derive a handle from
# an @mention in the caption when present). Without both vars set, instagram
# hashtags are skipped with a clear reason on /api/refresh.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""
INSTAGRAM_API_VERSION="v21.0"   # optional, defaults to v21.0
INSTAGRAM_MEDIA_EDGE="recent_media"  # optional: recent_media | top_media
